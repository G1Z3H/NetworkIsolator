<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <AssemblyName>NetworkIsolator</AssemblyName>
    <RootNamespace>NetworkIsolator</RootNamespace>
    <Version>3.0.0</Version>
    <Product>NetworkIsolator</Product>
    <Description>Blocks an application's network access with a targeted Windows Firewall rule</Description>

    <!-- Skips useless satellite language folders (fr, de, ...) when publishing -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
